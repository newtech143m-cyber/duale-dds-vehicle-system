{
  "name": "dds-vehicle-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @dds/database db:generate",
    "db:migrate": "pnpm --filter @dds/database db:migrate",
    "db:deploy": "pnpm --filter @dds/database db:deploy",
    "db:seed": "pnpm --filter @dds/database db:seed",
    "db:studio": "pnpm --filter @dds/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.10.0"
  }
}
