# ---------------------------------------------------------------
# DDS Vehicle System — environment variables (copy to .env)
# NEVER commit real values. Set them per Vercel project instead.
# ---------------------------------------------------------------

# --- Supabase Postgres (via Supavisor pooler) ---
# Runtime: TRANSACTION pooler (port 6543) with the portal's own least-privilege login role
#   registration portal -> dds_registration_login (member of dds_app)
#   verification portal -> dds_verification_login (member of dds_verifier)
DATABASE_URL="postgresql://dds_registration_login.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=no-verify"
# Supabase CA (PEM) for full TLS verification; when set, sslmode above is ignored. Escape newlines as \n.
DATABASE_CA_CERT=""
# Migrations / seed only: SESSION pooler (port 5432) with the postgres role. Never set on Vercel.
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# --- Supabase Auth (identity only; roles live in Postgres) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Server-only, registration portal only (staff invitation / suspension). Never set on the verification portal.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- Vercel Private Blob (photos & documents) ---
# On Vercel, OIDC auth is used automatically when the store is linked; this token is for local dev only.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- App ---
# "registration" or "verification" — enforced server-side; a verification deployment rejects staff-only actions
APP_PORTAL="registration"
OFFICE_TIMEZONE="Africa/Addis_Ababa"
# Signed-URL lifetime for private files, seconds
SIGNED_URL_TTL_SECONDS="300"
# Verification search rate limit (per officer per minute)
VERIFY_RATE_LIMIT_PER_MINUTE="30"
